# === LLM Configuration ===
# Provider: local | openrouter
LLM_PROVIDER=local

# OpenAI-compatible endpoint
# - For Ollama local: http://localhost:11434
# - For OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:11434

# API key
# - For Ollama local: ollama
# - For OpenRouter: sk-or-...
LLM_API_KEY=ollama

LLM_TEMPERATURE=0.7

# === Fallback LLM (local Ollama — used when paid/free tiers fail) ===
# PRD: OpenRouter is the single API. Local fallback is for dev only.
# Set LOCAL_LLM_FALLBACK=false to disable local Ollama fallback (production behavior).
LOCAL_LLM_FALLBACK=true
LLM_FALLBACK_PROVIDER=local
LLM_FALLBACK_MODEL=qwen2.5:7b
LLM_FALLBACK_BASE_URL=http://localhost:11434
LLM_FALLBACK_API_KEY=ollama

# === Auto-detect tier from API key ===
# The system automatically detects which tier to use:
# 1. paid  — API key has credits → AI selects best model from OpenRouter catalog
# 2. free  — API key is free tier → AI selects from free tool-capable models
# 3. local — no API key or all else fails → uses Ollama
#
# To switch to paid: just add credits to your OpenRouter account
# To switch to free: use a free-tier OpenRouter key
# To switch to local: set LLM_PROVIDER=local
#
# === OpenRouter setup ===
# 1. Get API key at https://openrouter.ai
# 2. Set:
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...

# === Media Generation (Image & Video) ===
# AI automatically selects image/video/search models from OpenRouter catalog.
# No manual configuration needed — just set LLM_API_KEY above.

# === AI Usage Hub (central cost/token logging) ===
# Push every AI/scraping provider call to the central Hub at digital.in.th.
# Token issued by sellcenter team per project. If unset, logging is a silent no-op.
# See: AI_USAGE_HUB_DEVELOPER_API.md
AI_USAGE_HUB_URL=https://digital.in.th
AI_USAGE_HUB_TOKEN=svc_42
# HTTP timeout for Hub push (seconds). Fire-and-forget — does not block callers.
AI_USAGE_HUB_TIMEOUT=5
